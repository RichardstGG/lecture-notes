# ===== 課堂即時轉錄設定 =====

# whisper.cpp 位置與模型
WHISPER_DIR="$HOME/whisper.cpp"
WHISPER_MODEL="$WHISPER_DIR/models/ggml-large-v3-turbo.bin"
WHISPER_HOST="127.0.0.1"
WHISPER_PORT="8178"
WHISPER_THREADS=8
WHISPER_LANG="zh"
BASE_PROMPT="以下是繁體中文的大學課堂內容。"

# 輸出根目錄（每堂課會建立 日期_課名 子資料夾）
LECTURE_ROOT="$HOME/lecture"

# 錄音來源：default 或 `pactl list short sources` 裡的名稱
AUDIO_SOURCE="alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source"

# 每段長度（秒）與重疊秒數
SEGMENT_SECONDS=300
OVERLAP_SECONDS=4

# 轉錄完成後保留原始 wav 分段（1=保留，0=轉完刪除）
KEEP_SEGMENTS=1
