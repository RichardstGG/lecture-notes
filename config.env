# ===== 課堂即時轉錄設定 =====

# whisper.cpp 位置與模型
WHISPER_DIR="$HOME/whisper.cpp"
WHISPER_MODEL="$WHISPER_DIR/models/ggml-large-v3-turbo.bin"
WHISPER_HOST="127.0.0.1"
WHISPER_PORT="8178"
WHISPER_THREADS=8
WHISPER_LANG="zh"
# 帶標點的 prompt 會讓輸出也傾向加標點；可加入課程術語
BASE_PROMPT="以下是繁體中文的大學課堂內容，老師會中英夾雜地講解。"

# 輸出根目錄（每堂課會建立 日期_課名 子資料夾）
LECTURE_ROOT="$HOME/lecture"

# 錄音來源（內建麥克風）
AUDIO_SOURCE="alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source"

# ---- VAD 切段 ----
VAD_MIN_CHUNK=12        # 至少累積幾秒才找停頓切段
VAD_MAX_CHUNK=30        # 最長幾秒，一直沒停頓就在最安靜處強制切
VAD_SILENCE_MS=500      # 停頓多久算可以切
VAD_SENSITIVITY=2.5     # 高於環境噪音幾倍算人聲；教室吵就調高（3–4），老師小聲就調低（1.8–2）

# ---- 文件排版 ----
SECTION_MINUTES=5       # 每幾分鐘一個 ## 時間小標題
PARA_GAP=2.5            # 停頓超過幾秒就換段落
PARA_MAX=220            # 段落超過幾個字就換段

# 是否保留整堂錄音（ogg/opus，3 小時約 45MB）
KEEP_RECORDING=1
# 若有安裝 opencc，把簡體輸出轉成台灣繁體用語（sudo apt install opencc）
USE_OPENCC=1
